      "item.mcanomalyarchives.pink_sheep_spawn_egg": "Pink Sheep Spawn Egg",
      "entity.mcanomalyarchives.pink_sheep": "Pink Sheep",
      "advancements.pink_sheep_sighting.title": "幸运粉羊",
      "advancements.pink_sheep_sighting.descr": "看到粉羊，收获好运",
      "advancements.pink_sheep_calamity.descr": "触发致命灾厄",
      "advancements.pink_sheep_calamity.title": "奇迹与你",
      "advancements.pink_sheep_blink.descr": "盯着粉色羊看，直到它在眨眼之间消失",
      "advancements.pink_sheep_blink.title": "眨眼",
      "codex.mcanomalyarchives.title": "The Archive",
      "codex.mcanomalyarchives.progress": "Deciphered %1$s / %2$s",
      "codex.mcanomalyarchives.locked": "???",
      "codex.mcanomalyarchives.locked_hint": "Not yet deciphered. It is recorded automatically once you encounter it.",
      "codex.mcanomalyarchives.planned": "This anomaly is not implemented in the mod yet; the file is incomplete.",
      "codex.mcanomalyarchives.level": "Class",
      "codex.mcanomalyarchives.protocol": "Protocol",
      "codex.mcanomalyarchives.traits": "Known traits",
      "codex.mcanomalyarchives.unlocked": "[Archive] Recorded %1$s %2$s",
      "item.mcanomalyarchives.anomaly_codex": "The Archive",
      "codex.mcanomalyarchives.uo001.name": "Fake Cloud",
      "codex.mcanomalyarchives.uo001.info": "A high-altitude anomaly shaped like a vanilla cloud. Three types - Ghost, Polymorph and Displaced - and it escapes through blocks. Its grey-blue fluid makes things phase out.",
      "codex.mcanomalyarchives.uo001.trait": "Glass cages cannot hold it · Animals inside suffocate · Water and lava stain grey-blue · Black individuals erase nearby blocks on contact",
      "codex.mcanomalyarchives.uo001.level": "R4",
      "codex.mcanomalyarchives.uo001.protocol": "B",
      "codex.mcanomalyarchives.uo002.name": "The Village That Isn\u0027t",
      "codex.mcanomalyarchives.uo002.info": "An inverted-colour village that only exists inside a specific rectangle of coordinates. Its villagers keep staring at you.",
      "codex.mcanomalyarchives.uo002.trait": "Invisible from outside the zone · Inverted colours, wrong materials · Villagers have no recognisable face · Trespassers turn inverted · The 「disaster」 traded from them makes the buyer vanish",
      "codex.mcanomalyarchives.uo002.level": "R1",
      "codex.mcanomalyarchives.uo002.protocol": "B",
      "codex.mcanomalyarchives.uo003.name": "Corn Poppy",
      "codex.mcanomalyarchives.uo003.info": "A poppy that makes you addicted to watching it. Look straight at it and you weep for no reason; onlookers have died.",
      "codex.mcanomalyarchives.uo003.trait": "Affects a 128-block diameter · Viewing through cameras blocks the effect · New instances grow from the faces of dead watchers",
      "codex.mcanomalyarchives.uo003.level": "Neutralised (formly R2)",
      "codex.mcanomalyarchives.uo003.protocol": "B",
      "codex.mcanomalyarchives.uo004.name": "Dimensional Fishing Rod",
      "codex.mcanomalyarchives.uo004.info": "Looks like an ordinary rod, yet it can pull things from outside the Overworld ashore.",
      "codex.mcanomalyarchives.uo004.trait": "Durability cap around 8.98x10^17, one point per cast · The further you cast, the stranger the catch · Catches are inedible or dangerous · A black fisherman\u0027s shadow keeps appearing nearby",
      "codex.mcanomalyarchives.uo004.level": "R0",
      "codex.mcanomalyarchives.uo004.protocol": "B",
      "codex.mcanomalyarchives.uo005.name": "Purple Monster",
      "codex.mcanomalyarchives.uo005.info": "A purple one-eyed humanoid in deep woods. It talks inside your head, pushes you toward negative options, and slowly assimilates you.",
      "codex.mcanomalyarchives.uo005.trait": "Its face is replaced by a single eye · Speaks mentally through an option window · Those who choose negative options turn purple · It vanishes in disgust when watched · Grows tendrils that impale",
      "codex.mcanomalyarchives.uo005.level": "R4",
      "codex.mcanomalyarchives.uo005.protocol": "Not stated",
      "codex.mcanomalyarchives.uo006.name": "The Ore Cave",
      "codex.mcanomalyarchives.uo006.info": "A bottomless, layered cave in the forest. The deeper you go the richer the ore - greed keeps you digging.",
      "codex.mcanomalyarchives.uo006.trait": "Six stages, from I Glimmer to VI Black Hole · Absurd veins, up to 822 iron in one · Attached anomalies: enriched ore, white miner ghosts, the thing you seek, the visionary golden gate · Old diggings vanish and the layout resets · Treasure taken out turns to ash",
      "codex.mcanomalyarchives.uo006.level": "R1",
      "codex.mcanomalyarchives.uo006.protocol": "S",
      "codex.mcanomalyarchives.uo007.name": "Negative Items",
      "codex.mcanomalyarchives.uo007.info": "A set of inverted-colour drops with negative stack counts, anti-properties and a retroactive effect.",
      "codex.mcanomalyarchives.uo007.trait": "Counts are negative, colours inverted · A negative apple lowers hunger and multiplies · A negative pickaxe gains durability and randomises blocks · Negative leggings cannot be removed and summon negative entities · Replaced blocks reappear in a nearby cave",
      "codex.mcanomalyarchives.uo007.level": "R0",
      "codex.mcanomalyarchives.uo007.protocol": "B",
      "codex.mcanomalyarchives.uo008.name": "Shapeshifting Name Tag",
      "codex.mcanomalyarchives.uo008.info": "A dark brown anomalous name tag recovered from a minecart cache inside a mineshaft. It inverts the causality of naming: a thing is not named after its properties - its properties are rewritten to match the name.",
      "codex.mcanomalyarchives.uo008.trait": "Changes the core, never the shell - Items and blocks must be named through an anvil - Item durability equals the number of characters in the name - Naming is irreversible; ordinary name tags cannot overwrite it - Cross-category conversion obeys material conservation and pays any deficit with an explosion - The number of extant tags is [DATA EXPUNGED]",
      "codex.mcanomalyarchives.uo008.level": "R1",
      "codex.mcanomalyarchives.uo008.protocol": "A",
      "codex.mcanomalyarchives.uo009.name": "The False Sun",
      "codex.mcanomalyarchives.uo009.info": "A higher-dimensional projected body, visible only to the mentally ill. It anchors to reality through gaze and magnifies the watcher\u0027s desire.",
      "codex.mcanomalyarchives.uo009.trait": "Visible only to the mentally ill · Anchors to reality by being watched; focus sharpens it · Magnifies inner desire, then brings calm · Its form follows the watcher\u0027s illness · Can rewrite collective perception",
      "codex.mcanomalyarchives.uo009.level": "R4",
      "codex.mcanomalyarchives.uo009.protocol": "A",
      "codex.mcanomalyarchives.uo010.name": "Dimensional Spyglass",
      "codex.mcanomalyarchives.uo010.info": "A grey telescope whose five dials let you see into other dimensions. Some images carry memetic contamination.",
      "codex.mcanomalyarchives.uo010.trait": "A grey telescope whose material much resembles UO-004 · Five dials α to ε below; δ and ε are broken · α shifts deviation from reality, β time, γ image density · Some images carry dangerous memetics causing extreme fear · A second viewing by the same person causes blindness",
      "codex.mcanomalyarchives.uo010.level": "R1",
      "codex.mcanomalyarchives.uo010.protocol": "B",
      "codex.mcanomalyarchives.uo011.name": "Strange Tree",
      "codex.mcanomalyarchives.uo011.info": "A black tree that burrows and lies in wait, then kills whoever fells trees nearby. Bedrock can trap it.",
      "codex.mcanomalyarchives.uo011.trait": "Trunk is near-bedrock hard · Leaves near-obsidian, regrowing instantly · After 7 to 9 trees felled it uproots and burrows · Approaches underground at about 3.1 m/s and cuts with scythe-like branches · Replanting one sapling per tree prevents it",
      "codex.mcanomalyarchives.uo011.level": "R2",
      "codex.mcanomalyarchives.uo011.protocol": "C",
      "codex.mcanomalyarchives.uo012.name": "Lucky Pink Sheep",
      "codex.mcanomalyarchives.uo012.info": "A pink sheep standing quietly in the plains. Looking at it brings luck; stare too long and it vanishes between two blinks.",
      "codex.mcanomalyarchives.uo012.trait": "Appears only in plains and similar open temperate biomes · Two seconds of sighting grants luck · Forty-five seconds of staring makes it blink away and relocate · Getting close or attacking triggers three tiers of calamity · The top tier gives no warning at all",
      "codex.mcanomalyarchives.uo012.level": "R4",
      "codex.mcanomalyarchives.uo012.protocol": "B",
      "death.attack.meteor_strike": "%1$s was obliterated by a meteor",
      "entity.mcanomalyarchives.pink_sheep_gift": "Pink Sheep\u0027s Gift",
      "item.mcanomalyarchives.baibian_name_tag": "Baibian Name Tag",
      "nametag.mcanomalyarchives.egg": "%s Egg",
      "entity.mcanomalyarchives.small_stange_cloud": "Small Stange Cloud",
      "item.mcanomalyarchives.small_stange_cloud_spawn_egg": "Small Stange Cloud Spawn Egg",
      "entity.mcanomalyarchives.black_stange_cloud": "Black Devouring Cloud",
      "item.mcanomalyarchives.black_stange_cloud_spawn_egg": "Black Devouring Cloud Spawn Egg",
      "item.mcanomalyarchives.yifulin_2_spawn_egg": "Yifulin Spawn Egg",
      "entity.mcanomalyarchives.yifulin_2": "Yifulin",
      "codex.mcanomalyarchives.first_sighting": "First contact",
      "codex.mcanomalyarchives.record_number": "Observation %s",
      "codex.mcanomalyarchives.continue_observing": "Further observations await first-hand experience.",
      "codex.mcanomalyarchives.note_added": "The archive has recorded another property of %s.",
      "codex.mcanomalyarchives.encounter.UO-001": "Cloud-shaped individuals float overhead. A closer look reveals they are not ordinary clouds.",
      "codex.mcanomalyarchives.encounter.UO-002": "Unrelated objects overlap. The characters in their name keep changing.",
      "codex.mcanomalyarchives.encounter.UO-003": "A familiar-looking poppy. Looking away is unexpectedly difficult.",
      "codex.mcanomalyarchives.encounter.UO-004": "An ordinary-looking fishing rod. Its catches remain to be investigated.",
      "codex.mcanomalyarchives.encounter.UO-005": "A humanoid appeared nearby. It seems aware of my presence.",
      "codex.mcanomalyarchives.encounter.UO-006": "No first-hand record.",
      "codex.mcanomalyarchives.encounter.UO-007": "No first-hand record.",
      "codex.mcanomalyarchives.encounter.UO-008": "A tag that accepts a written name. The significance of the name remains untested.",
      "codex.mcanomalyarchives.encounter.UO-009": "No first-hand record.",
      "codex.mcanomalyarchives.encounter.UO-010": "No first-hand record.",
      "codex.mcanomalyarchives.encounter.UO-011": "A seemingly ordinary tree, with differences that become apparent up close.",
      "codex.mcanomalyarchives.encounter.UO-012": "A pink sheep. Events around me began to feel unusual when I looked at it.",
      "codex.mcanomalyarchives.note.cloud_small": "Smaller cloud individuals have been seen moving through the air. Their size is not an effect of distance.",
      "codex.mcanomalyarchives.note.cloud_black": "A black cloud individual was sighted. Its coloration differs clearly; other properties remain unconfirmed.",
      "codex.mcanomalyarchives.note.garbled_spread": "While a menu containing a garbled object was open, another stack became garbled. The same menu appears to define its reach.",
      "codex.mcanomalyarchives.note.poppy_addiction": "Looking at the poppy caused an addictive response. The influence persisted after looking away.",
      "codex.mcanomalyarchives.note.fishing_catch": "The rod brought back something outside the usual catch. The water may connect elsewhere.",
      "codex.mcanomalyarchives.note.fishing_far": "An unusually distant cast produced a stronger disturbance. Casting distance may matter.",
      "codex.mcanomalyarchives.note.purple_arrival": "After remaining still while weakened or mentally strained, a humanoid appeared and initiated contact.",
      "codex.mcanomalyarchives.note.purple_change": "The humanoid changed color and posture during our conversation. Its initial appearance is not fixed.",
      "codex.mcanomalyarchives.note.purple_assimilation": "The encounter left a lasting influence. Its attention did not end with the conversation.",
      "codex.mcanomalyarchives.note.purple_stalker": "It was seen watching from afar. After noticing my gaze, it remained briefly before leaving.",
      "codex.mcanomalyarchives.note.purple_reward": "A purple tentacle remained after contact. It is a persistent object, not merely an image from that encounter.",
      "codex.mcanomalyarchives.note.name_rewrite": "An object rewritten by the tag was encountered. Its name appears connected to its properties.",
      "codex.mcanomalyarchives.note.name_garbled": "A name referring to no known object caused garbling. Arbitrary words are also acted upon.",
      "codex.mcanomalyarchives.note.name_mining": "A creature named Diamond Pickaxe began searching for ore. It reacted to the name of a tool.",
      "codex.mcanomalyarchives.note.name_erase": "The individual named Nothing vanished without an ordinary death.",
      "codex.mcanomalyarchives.note.name_mimic": "After receiving an online player\u0027s name, the target began imitating that player\u0027s actions.",
      "codex.mcanomalyarchives.note.tree_chase": "The tree was seen entering or emerging from the ground. Its location is not fixed.",
      "codex.mcanomalyarchives.note.sheep_blessing": "A blessing followed observation of the pink sheep. It appears connected with good fortune.",
      "codex.mcanomalyarchives.note.sheep_calamity": "An event associated with the sheep escalated into calamity. Previous luck did not guarantee safety.",
      "codex.mcanomalyarchives.note.sheep_blink": "The watched sheep vanished abruptly, without walking away.",
      "codex.mcanomalyarchives.note.cloud_contact": "Entering the cloud\u0027s area of influence caused injury. Its soft appearance does not make contact safe.",
      "codex.mcanomalyarchives.note.cloud_transmute": "Liquid near the cloud changed. Ordinary water or lava was replaced by cloud water or cloud stone.",
      "codex.mcanomalyarchives.note.cloud_red": "A red small cloud was sighted. Similar shape does not establish identical properties.",
      "codex.mcanomalyarchives.note.cloud_erase": "Blocks disappeared near a passing black cloud without leaving corresponding drops.",
      "codex.mcanomalyarchives.note.poppy_withdrawal": "A sadness response followed looking away from the poppy. Its influence was not easily shaken off.",
      "codex.mcanomalyarchives.note.fishing_living": "The rod brought back a living creature. An entire individual passed through the water\u0027s surface.",
      "codex.mcanomalyarchives.note.purple_pet": "Another animal appeared during the encounter. Touching it was followed by another transformation of the purple individual.",
      "codex.mcanomalyarchives.note.name_absorb": "A named creature took matching materials from its surroundings. The transformation affects physical objects nearby.",
      "codex.mcanomalyarchives.note.name_compression": "An unstable named object exploded when used. The requested change appears to have exceeded what the original object could support.",
      "codex.mcanomalyarchives.note.tree_replant": "Planting a sapling during pursuit interrupted the tree\u0027s tracking. Replanting appears connected with its response.",
      "codex.mcanomalyarchives.note.tree_exposure": "The tree began burrowing after much of its root area became exposed. Ground cover affects whether it stays.",
      "block.mcanomalyarchives.uo002_misplaced": "§k错位异变乱码虚无界面§r",
      "item.mcanomalyarchives.uo002_garbled.tooltip": "An error item gradually infects items in the same open interface.",
      "item.mcanomalyarchives.negative_apple": "Negative Apple",
      "item.mcanomalyarchives.negative_diamond_pickaxe": "Negative Diamond Pickaxe",
      "item.mcanomalyarchives.uo002_garbled": "§k错位异变乱码虚无界面§r",
      "item.mcanomalyarchives.uo002_misplaced": "§k错位异变乱码虚无界面§r",
      "codex.mcanomalyarchives.note.negative_apple": "Eating a negative apple deepened hunger, while the number of negative apples increased.",
      "codex.mcanomalyarchives.note.negative_pickaxe": "The negative diamond pickaxe barely wore down. Nearby stone changed, and a displaced stone later appeared in a nearby cave.",
      "item.mcanomalyarchives.negative_bow": "Negative Bow",
      "item.mcanomalyarchives.negative_arrow": "Negative Arrow",
      "entity.mcanomalyarchives.negative_return_arrow": "Arrow",
      "codex.mcanomalyarchives.note.negative_bow_release": "Releasing the negative bow produced no outgoing arrow. Instead, an ordinary arrow returned to my inventory.",
      "codex.mcanomalyarchives.note.negative_bow_return": "After a delay, an arrow flew back at high speed from the aimed direction toward its shooter. Releasing the bow was not the end of the shot.",
      "item.mcanomalyarchives.negative_music_disc": "Negative Music Disc",
      "jukebox_song.mcanomalyarchives.negative_cat": "C418 — cat (Reversed)",
      "codex.mcanomalyarchives.note.negative_disc_sound": "The disc muffled the surrounding sounds. Colours inverted and a ripple crossed the frozen space.",
      "codex.mcanomalyarchives.note.negative_disc_rewind": "Blocks, creatures and items within roughly fifty blocks returned to the recorded past, up to ten seconds ago. My discoveries remained.",
      "codex.mcanomalyarchives.note.negative_disc_wear": "Rewinding cannot repair the disc itself. Each successful rewind uses one charge; it vanishes after ten uses.",
      "message.mcanomalyarchives.rewind.warming": "No past recorded yet. Wait briefly near the jukebox, then reinsert. Available history is rewound, up to ten seconds.",
      "message.mcanomalyarchives.rewind.chunks": "Surrounding chunks are not loaded. Cancelled without wear.",
      "message.mcanomalyarchives.rewind.machine": "A nearby block entity cannot be fully recorded. Cancelled without wear.",
      "message.mcanomalyarchives.rewind.menu": "Transient crafting inputs interrupted recording. Clear the crafting grid, close the menu and wait briefly.",
      "message.mcanomalyarchives.rewind.boundary": "Objects or items crossed the rewind boundary during the last ten seconds. Cancelled without wear.",
      "message.mcanomalyarchives.rewind.busy": "Too many changes to record, or another rewind is active. No wear applied.",
      "message.mcanomalyarchives.rewind.worn": "This disc is exhausted.",
      "item.mcanomalyarchives.negative_dirt": "Negative Dirt",
      "item.mcanomalyarchives.negative_oak_log": "Negative Oak Log",
      "item.mcanomalyarchives.negative_oak_planks": "Negative Oak Planks",
      "block.mcanomalyarchives.negative_space": "Negative Space",
      "codex.mcanomalyarchives.note.negative_block_place": "Placing a negative block leaves black space instead of its material. It dissolves gradually and vanishes after about thirty seconds.",
      "codex.mcanomalyarchives.note.negative_space_contact": "Touching the black space causes lethal damage.",
      "item.mcanomalyarchives.negative_wooden_pickaxe": "Negative Wooden Pickaxe",
      "block.mcanomalyarchives.liquid_cobblestone": "Liquid Cobblestone",
      "codex.mcanomalyarchives.note.negative_block_return": "After the negative space dissolved, its ordinary material reappeared in an empty spot in a nearby cave.",
      "codex.mcanomalyarchives.note.name_liquid_stone": "Cobblestone named water spread into a sticky grey layer and evaporated into dust. It dissipated after about eleven minutes.",
      "codex.mcanomalyarchives.note.name_potato": "The creature named potato stopped moving, gradually became tuber-like, sprouted and finally left potatoes behind.",
      "message.mcanomalyarchives.earth.active": "An Earth anomaly is already active in this dimension. The name tag was not consumed.",
      "codex.mcanomalyarchives.note.name_earth": "The accepted name warped local space with yellow light. The event persisted independently of its anchor.",
      "codex.mcanomalyarchives.note.earth_pull": "Gravity dragged me toward the collapsing ground. Escaping became harder closer to the center.",
      "codex.mcanomalyarchives.note.earth_blast": "After a vast crater formed, its center exploded and the collapse spread farther outward.",
      "codex.mcanomalyarchives.note.earth_rewind": "Only a record preceding the naming removes Earth. Rewinding to a later point merely delays the catastrophe.",
