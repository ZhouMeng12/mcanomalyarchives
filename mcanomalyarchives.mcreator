      "item.mcanomalyarchives.pale_spawn_egg": "???刷怪蛋",
      "item.mcanomalyarchives.remnant_spawn_egg": "???刷怪蛋",
      "item.mcanomalyarchives.fold_spawn_egg": "???刷怪蛋",
      "item_group.mcanomalyarchives.anomaly_archives": "诡异见闻录",
      "subtitles.anbula_berserk": "[黑]",
      "item.mcanomalyarchives.pink_sheep_spawn_egg": "幸运粉羊刷怪蛋",
      "entity.mcanomalyarchives.pink_sheep": "幸运粉羊",
      "advancements.pink_sheep_sighting.title": "幸运粉羊",
      "advancements.pink_sheep_sighting.descr": "看到粉羊，收获好运",
      "advancements.pink_sheep_calamity.descr": "触发致命灾厄",
      "advancements.pink_sheep_calamity.title": "奇迹与你",
      "advancements.pink_sheep_blink.descr": "盯着粉色羊看，直到它在眨眼之间消失",
      "advancements.pink_sheep_blink.title": "眨眼",
      "codex.mcanomalyarchives.title": "见闻录",
      "codex.mcanomalyarchives.progress": "已解明 %1$s / %2$s",
      "codex.mcanomalyarchives.locked": "???",
      "codex.mcanomalyarchives.locked_hint": "尚未解明——在游戏中遇到它之后会自动记录。",
      "codex.mcanomalyarchives.planned": "该异常尚未在本模组中实装，档案暂缺。",
      "codex.mcanomalyarchives.level": "项目等级",
      "codex.mcanomalyarchives.protocol": "保密协议",
      "codex.mcanomalyarchives.traits": "已知特征",
      "codex.mcanomalyarchives.unlocked": "[见闻录] 已记录 %1$s %2$s",
      "item.mcanomalyarchives.anomaly_codex": "见闻录",
      "codex.mcanomalyarchives.uo001.name": "伪云",
      "codex.mcanomalyarchives.uo001.info": "形似原版云朵的高空异常，能穿透方块逃离；其灰蓝液体可使人虚化。",
      "codex.mcanomalyarchives.uo001.trait": "玻璃困笼困不住它 · 内部动物窒息死亡 · 水体与岩浆被染成灰蓝 · 黑色个体接触方块会令其离奇消失",
      "codex.mcanomalyarchives.uo001.level": "R4",
      "codex.mcanomalyarchives.uo001.protocol": "B",
      "codex.mcanomalyarchives.uo002.name": "不存在的村庄",
      "codex.mcanomalyarchives.uo002.info": "只有踏入指定矩形坐标区才会浮现的反色村庄，村民会一直盯着你。",
      "codex.mcanomalyarchives.uo002.trait": "区外建筑形同不存在 · 建筑呈反向色彩与错误材质 · 村民面部无法识别 · 越界者全身反色 · 与异常村民交易换来的「灾难」会令见者凭空消失",
      "codex.mcanomalyarchives.uo002.level": "R1",
      "codex.mcanomalyarchives.uo002.protocol": "B",
      "codex.mcanomalyarchives.uo003.name": "虞美人",
      "codex.mcanomalyarchives.uo003.info": "一朵让人观赏成瘾的虞美人。直视它会莫名悲伤流泪，围观者可能因此丧命。",
      "codex.mcanomalyarchives.uo003.trait": "影响范围直径达 128 格 · 通过监控等视觉载体观看可阻挡其影响 · 收容一段时间分泌泪滴 · 观赏者尸体脸部会长出新的个体",
      "codex.mcanomalyarchives.uo003.level": "无效化（原 R2）",
      "codex.mcanomalyarchives.uo003.protocol": "B",
      "codex.mcanomalyarchives.uo004.name": "跨维钓竿",
      "codex.mcanomalyarchives.uo004.info": "外观与普通钓竿无异，却能把主世界之外的东西钓上岸。",
      "codex.mcanomalyarchives.uo004.trait": "鱼线抛得越远，钓出的东西越脱离常规 · 钓上物或具危险性 ",
      "codex.mcanomalyarchives.uo004.level": "R0",
      "codex.mcanomalyarchives.uo004.protocol": "B",
      "codex.mcanomalyarchives.uo005.name": "紫怪",
      "codex.mcanomalyarchives.uo005.info": "紫色独眼人形实体，出没于密林，以精神对话诱导你选择负面选项，并逐渐把你同化。",
      "codex.mcanomalyarchives.uo005.trait": "面部被单只眼睛取代 · 在脑内交流并弹出选项窗口 · 选择负面选项者皮肤会紫化 · 被人类观察时表现厌恶并消失 · 能长出触肢贯穿杀人",
      "codex.mcanomalyarchives.uo005.level": "R4",
      "codex.mcanomalyarchives.uo005.protocol": "未标注",
      "codex.mcanomalyarchives.uo006.name": "鑛洞",
      "codex.mcanomalyarchives.uo006.info": "森林中深不见底的分层矿洞，越深矿物越多，以贪婪诱人不停下挖。",
      "codex.mcanomalyarchives.uo006.trait": "分 Ⅰ闪星～Ⅵ黑洞 六阶段层 · 矿脉体量异常，最高单脉 822 个铁矿 · 附属异常：富集矿石、白色矿工虚影、所求之物、愿景金门 · 旧挖掘痕迹会消失、结构重置 · 带出的宝藏会化为灰烬",
      "codex.mcanomalyarchives.uo006.level": "R1",
      "codex.mcanomalyarchives.uo006.protocol": "S",
      "codex.mcanomalyarchives.uo007.name": "负值物品",
      "codex.mcanomalyarchives.uo007.info": "某处出现的一系列反向色彩、负数量掉落物，具反属性与回溯效应。",
      "codex.mcanomalyarchives.uo007.trait": "物品数量为负、色彩与原版相反 · 负苹果吃下后饱食度下降、数量反增 · 负镐挖掘时耐久增加，方块被随机替换 · 负护腿无法脱下，会招来负值实体 · 被替换的方块会回溯到附近矿洞",
      "codex.mcanomalyarchives.uo007.level": "R0",
      "codex.mcanomalyarchives.uo007.protocol": "B",
      "codex.mcanomalyarchives.uo008.name": "百变命名牌",
      "codex.mcanomalyarchives.uo008.info": "深褐色的异常命名牌，出自一处矿井里的矿车宝藏。它倒置了命名的因果——不是按特性起名，而是按名字赋予特性。",
      "codex.mcanomalyarchives.uo008.trait": "只改内核、不改外壳 · 物品与方块必须过铁砧才能命名 · 命名不可逆，普通命名牌覆盖无效 · 跨类转化遵循质料守恒，撑不住就以爆炸偿付 · 现存数量被协会[数据删除]",
      "codex.mcanomalyarchives.uo008.level": "R1",
      "codex.mcanomalyarchives.uo008.protocol": "A",
      "codex.mcanomalyarchives.uo009.name": "假太阳",
      "codex.mcanomalyarchives.uo009.info": "高维投影天体，只有精神疾病患者能看见；它靠注视锚定现实，并放大观测者内心的渴望。",
      "codex.mcanomalyarchives.uo009.trait": "仅精神病患者可见 · 靠注视锚定于现实，专注越深成像越清晰 · 先放大内心渴望，再使人陷入宁静 · 形态随观测者的疾病而变 · 可改写集体认知",
      "codex.mcanomalyarchives.uo009.level": "R4",
      "codex.mcanomalyarchives.uo009.protocol": "A",
      "codex.mcanomalyarchives.uo010.name": "跨维窥镜",
      "codex.mcanomalyarchives.uo010.info": "一台灰色望远镜，五个旋钮可以窥视其他维度的事物；部分成像带有模因污染。",
      "codex.mcanomalyarchives.uo010.trait": "外观是灰色望远镜，材质酷似 UO-004 · 侧下有 α~ε 五个旋钮，δ、ε 已损坏 · α 调偏离现实程度、β 调时间、γ 调成像密度 · 部分成像带危险模因污染，会引发极端恐惧 · 同一人观测两次以上会致盲",
      "codex.mcanomalyarchives.uo010.level": "R1",
      "codex.mcanomalyarchives.uo010.protocol": "B",
      "codex.mcanomalyarchives.uo011.name": "怪树",
      "codex.mcanomalyarchives.uo011.info": "黑色的怪树，会钻地潜伏，并斩杀附近连续砍树的人。",
      "codex.mcanomalyarchives.uo011.trait": "树干硬度接近基岩，无法破坏 · 树叶接近黑曜石，破坏后瞬间再生 · 累计砍 7~9 棵树即连根拔起钻入地下 · 以约 3.1 m/s 从地下接近，用镰刀状枝条斩杀 · 每砍一棵补种一棵树苗则不会触发",
      "codex.mcanomalyarchives.uo011.level": "R2",
      "codex.mcanomalyarchives.uo011.protocol": "C",
      "codex.mcanomalyarchives.uo012.name": "幸运粉羊",
      "codex.mcanomalyarchives.uo012.info": "平原上静静站着的粉色羊。注视它会得到好运；它会在你不看他的一瞬间消失。",
      "codex.mcanomalyarchives.uo012.trait": "只在平原等温和开阔群系出现 · 目击会获得幸运 · 凝视一段时间它会眨眼消失并转移 · 靠得太近或攻击它会招来灾厄",
      "codex.mcanomalyarchives.uo012.level": "R4",
      "codex.mcanomalyarchives.uo012.protocol": "B",
      "entity.mcanomalyarchives.sitting_enity": "",
      "item_group.mcanomalyarchives.strange_record": "MC诡异见闻录",
      "death.attack.meteor_strike": "%1$s被陨石砸成了坑",
      "entity.mcanomalyarchives.pink_sheep_gift": "粉羊的礼物",
      "item.mcanomalyarchives.baibian_name_tag": "百变命名牌",
      "nametag.mcanomalyarchives.egg": "%s蛋",
      "entity.mcanomalyarchives.small_stange_cloud": "小伪云",
      "item.mcanomalyarchives.small_stange_cloud_spawn_egg": "小伪云刷怪蛋",
      "entity.mcanomalyarchives.black_stange_cloud": "黑吸伪云",
      "item.mcanomalyarchives.black_stange_cloud_spawn_egg": "黑吸伪云刷怪蛋",
      "item.mcanomalyarchives.yifulin_2_spawn_egg": "伊芙琳?刷怪蛋",
      "entity.mcanomalyarchives.yifulin_2": "伊芙琳？",
      "codex.mcanomalyarchives.first_sighting": "初次接触",
      "codex.mcanomalyarchives.record_number": "见闻 · %s",
      "codex.mcanomalyarchives.continue_observing": "后续见闻，待亲身经历后续写。",
      "codex.mcanomalyarchives.note_added": "《见闻录》续写了「%s」的一条性质。",
      "codex.mcanomalyarchives.encounter.UO-001": "天空中漂浮着形似云团的个体。靠近时，才发觉它并非普通的云。",
      "codex.mcanomalyarchives.encounter.UO-002": "几种不相干的物体挤在一起。名称中的字符不断变化，无法准确辨认。",
      "codex.mcanomalyarchives.encounter.UO-003": "一株虞美人。它的外形很熟悉，却让人难以移开视线。",
      "codex.mcanomalyarchives.encounter.UO-004": "一支外形普通的钓竿。它能钓上什么，需要亲自尝试。",
      "codex.mcanomalyarchives.encounter.UO-005": "一个人形个体出现在附近。它似乎知道我在这里。",
      "codex.mcanomalyarchives.encounter.UO-006": "尚无亲历记录。",
      "codex.mcanomalyarchives.encounter.UO-007": "尚无亲历记录。",
      "codex.mcanomalyarchives.encounter.UO-008": "一张可以写上名字的命名牌。写下的名称究竟有什么意义，仍需验证。",
      "codex.mcanomalyarchives.encounter.UO-009": "尚无亲历记录。",
      "codex.mcanomalyarchives.encounter.UO-010": "尚无亲历记录。",
      "codex.mcanomalyarchives.encounter.UO-011": "一棵看似普通的树。只有近看，才发现它与周围的树木有所不同。",
      "codex.mcanomalyarchives.encounter.UO-012": "一只粉色的羊。我看向它时，感觉周围的事情开始有些不对。",
      "codex.mcanomalyarchives.note.cloud_small": "另见体型更小的伪云个体。它们也在空中活动，并非远处大个体造成的错觉。",
      "codex.mcanomalyarchives.note.cloud_black": "目击了黑色的伪云个体。颜色与普通个体明显不同，其余性质尚待观察。",
      "codex.mcanomalyarchives.note.garbled_spread": "打开容纳乱码物品的界面后，另一组物品也变成了乱码。同一界面似乎构成了传播范围。",
      "codex.mcanomalyarchives.note.poppy_addiction": "注视虞美人后出现了上瘾反应。凝视带来的影响会留在身上，并非移开视线就立刻结束。",
      "codex.mcanomalyarchives.note.fishing_catch": "这支钓竿收回了不属于寻常鱼获的东西。水面之下可能连接着别处。",
      "codex.mcanomalyarchives.note.fishing_far": "一次远距离抛投后，收线处发生了更明显的异常。抛出的距离可能与异常程度有关。",
      "codex.mcanomalyarchives.note.purple_arrival": "在虚弱或精神不稳时长时间静止，人形个体现身并主动接触了我。",
      "codex.mcanomalyarchives.note.purple_change": "交谈中的人形个体改变了颜色与姿态。它最初的外表并非固定形态。",
      "codex.mcanomalyarchives.note.purple_assimilation": "这次接触留下了持续影响。即使交谈结束，我也没有完全脱离它的关注。",
      "codex.mcanomalyarchives.note.purple_stalker": "再次发现它在远处窥视。确认被我注意到后，它没有马上离开，而是继续停留了一小段时间。",
      "codex.mcanomalyarchives.note.purple_reward": "接触结束后得到了一段紫色触手。这个物体能够留存下来，并非当时的幻觉。",
      "codex.mcanomalyarchives.note.name_rewrite": "接触到被命名牌改写的对象。名称与对象的性质发生了关联。",
      "codex.mcanomalyarchives.note.name_garbled": "无法对应已知事物的名字引发了乱码。随意写下的字词也会被这张命名牌执行。",
      "codex.mcanomalyarchives.note.name_mining": "生物被命名为“钻石镐”后，开始表现出寻找矿石的行为。它对工具名称作出了反应。",
      "codex.mcanomalyarchives.note.name_erase": "命名为“无”的对象在眼前消失了。现场没有留下正常的死亡过程。",
      "codex.mcanomalyarchives.note.name_mimic": "使用一名在线玩家的名字后，目标开始模仿那名玩家的动作。名称似乎指向了具体身份。",
      "codex.mcanomalyarchives.note.tree_chase": "目击怪树钻入或钻出地面。树木的位置并非固定，地下也可能成为它活动的一部分。",
      "codex.mcanomalyarchives.note.sheep_blessing": "注视粉羊后获得了祝福。它与幸运之间似乎存在联系。",
      "codex.mcanomalyarchives.note.sheep_calamity": "与粉羊有关的事件发展成了灾厄。先前的幸运不能保证下一次仍有好结果。",
      "codex.mcanomalyarchives.note.sheep_blink": "凝视中的粉羊突然消失了。它的离开没有经过正常行走的过程。",
      "codex.mcanomalyarchives.note.cloud_contact": "进入伪云影响的范围后受到了伤害。柔软的云状外观并不代表可以安全接触。",
      "codex.mcanomalyarchives.note.cloud_transmute": "目击伪云附近的液体发生变化。原有的水或岩浆被替换成了云水或云石。",
      "codex.mcanomalyarchives.note.cloud_red": "发现红色的小伪云。它的颜色与通常个体不同，不能仅凭外形相似就判断性质一致。",
      "codex.mcanomalyarchives.note.cloud_erase": "黑色伪云经过时，附近方块消失了，现场没有留下对应的掉落物。",
      "codex.mcanomalyarchives.note.poppy_withdrawal": "离开虞美人的注视后，出现了悲伤反应。摆脱它的影响并不轻松。",
      "codex.mcanomalyarchives.note.fishing_living": "钓竿拉回了活着的生物。有些东西以完整个体的形式穿过了水面。",
      "codex.mcanomalyarchives.note.purple_pet": "交谈中出现了另一只动物。触摸它后，眼前的紫色个体再次改变了形态。",
      "codex.mcanomalyarchives.note.name_absorb": "目击被命名的生物夺走附近的同类材料。转化会影响它身边实际存在的物体。",
      "codex.mcanomalyarchives.note.name_compression": "一次命名产生的不稳定物体在使用时爆炸。名称所要求的变化似乎超出了原物体能够承受的程度。",
      "codex.mcanomalyarchives.note.tree_replant": "追踪期间种下树苗后，怪树的追踪被中止了。补种与它的反应有关。",
      "codex.mcanomalyarchives.note.tree_exposure": "根部大面积暴露后，怪树开始钻入地下。地面的包覆程度会影响它是否停留。",
      "block.mcanomalyarchives.uo002_misplaced": "§k错位异变乱码虚无界面§r",
      "item.mcanomalyarchives.uo002_garbled.tooltip": "错误物品会逐渐感染同一界面内的物品。",
      "item.mcanomalyarchives.negative_apple": "负值苹果",
      "item.mcanomalyarchives.negative_diamond_pickaxe": "负值钻石镐",
      "item.mcanomalyarchives.uo002_garbled": "§k错位异变乱码虚无界面§r",
      "item.mcanomalyarchives.uo002_misplaced": "§k错位异变乱码虚无界面§r",
      "codex.mcanomalyarchives.note.negative_apple": "吃下负值苹果后，饥饿感反而加深；手中的负值苹果数量也增加了。",
      "codex.mcanomalyarchives.note.negative_pickaxe": "负值钻石镐挖掘时几乎没有损耗，附近石层却发生了替换；一块石材随后在附近洞穴重新出现。",
      "item.mcanomalyarchives.negative_bow": "负值弓",
      "item.mcanomalyarchives.negative_arrow": "负值箭",
      "entity.mcanomalyarchives.negative_return_arrow": "箭",
      "codex.mcanomalyarchives.note.negative_bow_release": "负值弓松弦后，没有箭从弓上飞出，反而补回了一支普通箭。",
      "codex.mcanomalyarchives.note.negative_bow_return": "延迟后，一支箭从瞄准的方向高速飞回射手。一次放箭并没有在松弦时结束。",
      "item.mcanomalyarchives.negative_music_disc": "负值唱片",
      "jukebox_song.mcanomalyarchives.negative_cat": "C418 — cat（倒流）",
      "codex.mcanomalyarchives.note.negative_disc_sound": "唱片响起时，周围的声音被压低，颜色翻转，波纹穿过静止的空间。",
      "codex.mcanomalyarchives.note.negative_disc_rewind": "波纹收回后，周围约五十格内的方块、生物与物品回到了过去，最远约十秒前。我的见闻仍然保留。",
      "codex.mcanomalyarchives.note.negative_disc_wear": "回溯无法修复唱片自身的损耗。每次成功倒流消耗一次，十次后消失。",
      "message.mcanomalyarchives.rewind.warming": "尚无可回溯的记录：请在唱片机附近稍等后重新插入。有多少历史就回溯多少，最多十秒。",
      "message.mcanomalyarchives.rewind.chunks": "周围尚未完全加载，倒流中止；唱片未损耗。",
      "message.mcanomalyarchives.rewind.machine": "附近存在无法完整记录的方块实体，倒流中止；唱片未损耗。",
      "message.mcanomalyarchives.rewind.menu": "临时合成栏打断了记录。清空合成格并关闭工作界面，稍等后再试。",
      "message.mcanomalyarchives.rewind.boundary": "过去十秒内有物体或物品跨越回溯边界，倒流中止；唱片未损耗。",
      "message.mcanomalyarchives.rewind.busy": "变化超过记录容量，或已有倒流正在进行；唱片未损耗。",
      "message.mcanomalyarchives.rewind.worn": "这张唱片已经耗尽。",
      "item.mcanomalyarchives.negative_dirt": "负值泥土",
      "item.mcanomalyarchives.negative_oak_log": "负值橡木原木",
      "item.mcanomalyarchives.negative_oak_planks": "负值橡木木板",
      "block.mcanomalyarchives.negative_space": "负空间",
      "codex.mcanomalyarchives.note.negative_block_place": "负值方块没有留下对应的物质，而是形成黑色空间。黑色空间逐渐溶解，约三十秒后消失。",
      "codex.mcanomalyarchives.note.negative_space_contact": "接触黑色空间会遭遇致命伤害。",
      "item.mcanomalyarchives.negative_wooden_pickaxe": "负值木镐",
      "block.mcanomalyarchives.liquid_cobblestone": "液态原石",
      "codex.mcanomalyarchives.note.negative_block_return": "负空间消散后，附近洞穴的空位出现了对应的普通物质。",
      "codex.mcanomalyarchives.note.name_liquid_stone": "命名为水的原石蔓延成灰色液层，黏附接触者并不断化为粉尘。约十一分钟后消散。",
      "codex.mcanomalyarchives.note.name_potato": "被命名为土豆的生物先停止活动，身体逐渐块茎化并发芽，最后留下土豆。",
      "message.mcanomalyarchives.earth.active": "这个维度已有地球异常正在发生，命名牌未消耗。",
      "codex.mcanomalyarchives.note.name_earth": "名字被接受后，局部空间扭曲并泛起黄光。异常没有随着兔子的死亡或离开而消失。",
      "codex.mcanomalyarchives.note.earth_pull": "巨大的吸引力将我拖向中心；地面持续坍陷，越靠近中心越难逃离。",
      "codex.mcanomalyarchives.note.earth_blast": "坍陷形成巨坑后，中心爆炸，冲击继续撕开更远的地面。",
      "codex.mcanomalyarchives.note.earth_rewind": "回到命名前的记录，才能解除地球异常。只倒退到灾变中的时间，灾变仍会继续。",
