      "item_group.mcanomalyarchives.anomaly_archives": "诡异见闻录",
      "subtitles.anbula_berserk": "[黑]",
      "item.mcanomalyarchives.pink_sheep_spawn_egg": "幸运粉羊刷怪蛋",
      "entity.mcanomalyarchives.pink_sheep": "幸运粉羊",
      "advancements.pink_sheep_sighting.title": "幸运粉羊",
      "advancements.pink_sheep_sighting.descr": "看到粉羊，收获好运",
      "advancements.pink_sheep_calamity.descr": "触发致命灾厄",
      "advancements.pink_sheep_calamity.title": "奇迹与你",
      "advancements.pink_sheep_blink.descr": "盯着粉色羊看，直到它在眨眼之间消失",
      "advancements.pink_sheep_blink.title": "眨眼",
      "codex.mcanomalyarchives.title": "见闻录",
      "codex.mcanomalyarchives.progress": "已解明 %1$s / %2$s",
      "codex.mcanomalyarchives.locked": "???",
      "codex.mcanomalyarchives.locked_hint": "尚未解明——在游戏中遇到它之后会自动记录。",
      "codex.mcanomalyarchives.planned": "该异常尚未在本模组中实装，档案暂缺。",
      "codex.mcanomalyarchives.level": "项目等级",
      "codex.mcanomalyarchives.protocol": "保密协议",
      "codex.mcanomalyarchives.traits": "已知特征",
      "codex.mcanomalyarchives.unlocked": "[见闻录] 已记录 %1$s %2$s",
      "item.mcanomalyarchives.anomaly_codex": "见闻录",
      "codex.mcanomalyarchives.uo001.name": "伪云",
      "codex.mcanomalyarchives.uo001.info": "形似原版云朵的高空异常，能穿透方块逃离；其灰蓝液体可使人虚化。",
      "codex.mcanomalyarchives.uo001.trait": "玻璃困笼困不住它 · 内部动物窒息死亡 · 水体与岩浆被染成灰蓝 · 黑色个体接触方块会令其离奇消失",
      "codex.mcanomalyarchives.uo001.level": "R4",
      "codex.mcanomalyarchives.uo001.protocol": "B",
      "codex.mcanomalyarchives.uo002.name": "不存在的村庄",
      "codex.mcanomalyarchives.uo002.info": "只有踏入指定矩形坐标区才会浮现的反色村庄，村民会一直盯着你。",
      "codex.mcanomalyarchives.uo002.trait": "区外建筑形同不存在 · 建筑呈反向色彩与错误材质 · 村民面部无法识别 · 越界者全身反色 · 与异常村民交易换来的「灾难」会令见者凭空消失",
      "codex.mcanomalyarchives.uo002.level": "R1",
      "codex.mcanomalyarchives.uo002.protocol": "B",
      "codex.mcanomalyarchives.uo003.name": "虞美人",
      "codex.mcanomalyarchives.uo003.info": "一朵让人观赏成瘾的虞美人。直视它会莫名悲伤流泪，围观者可能因此丧命。",
      "codex.mcanomalyarchives.uo003.trait": "影响范围直径达 128 格 · 通过监控等视觉载体观看可阻挡其影响 · 收容一段时间分泌泪滴 · 观赏者尸体脸部会长出新的个体",
      "codex.mcanomalyarchives.uo003.level": "无效化（原 R2）",
      "codex.mcanomalyarchives.uo003.protocol": "B",
      "codex.mcanomalyarchives.uo004.name": "跨维钓竿",
      "codex.mcanomalyarchives.uo004.info": "外观与普通钓竿无异，却能把主世界之外的东西钓上岸。",
      "codex.mcanomalyarchives.uo004.trait": "鱼线抛得越远，钓出的东西越脱离常规 · 钓上物或具危险性 ",
      "codex.mcanomalyarchives.uo004.level": "R0",
      "codex.mcanomalyarchives.uo004.protocol": "B",
      "codex.mcanomalyarchives.uo005.name": "紫怪",
      "codex.mcanomalyarchives.uo005.info": "紫色独眼人形实体，出没于密林，以精神对话诱导你选择负面选项，并逐渐把你同化。",
      "codex.mcanomalyarchives.uo005.trait": "面部被单只眼睛取代 · 在脑内交流并弹出选项窗口 · 选择负面选项者皮肤会紫化 · 被人类观察时表现厌恶并消失 · 能长出触肢贯穿杀人",
      "codex.mcanomalyarchives.uo005.level": "R4",
      "codex.mcanomalyarchives.uo005.protocol": "未标注",
      "codex.mcanomalyarchives.uo006.name": "鑛洞",
      "codex.mcanomalyarchives.uo006.info": "森林中深不见底的分层矿洞，越深矿物越多，以贪婪诱人不停下挖。",
      "codex.mcanomalyarchives.uo006.trait": "分 Ⅰ闪星～Ⅵ黑洞 六阶段层 · 矿脉体量异常，最高单脉 822 个铁矿 · 附属异常：富集矿石、白色矿工虚影、所求之物、愿景金门 · 旧挖掘痕迹会消失、结构重置 · 带出的宝藏会化为灰烬",
      "codex.mcanomalyarchives.uo006.level": "R1",
      "codex.mcanomalyarchives.uo006.protocol": "S",
      "codex.mcanomalyarchives.uo007.name": "负值物品",
      "codex.mcanomalyarchives.uo007.info": "某处出现的一系列反向色彩、负数量掉落物，具反属性与回溯效应。",
      "codex.mcanomalyarchives.uo007.trait": "物品数量为负、色彩与原版相反 · 负苹果吃下后饱食度下降、数量反增 · 负镐挖掘时耐久增加，方块被随机替换 · 负护腿无法脱下，会招来负值实体 · 被替换的方块会回溯到附近矿洞",
      "codex.mcanomalyarchives.uo007.level": "R0",
      "codex.mcanomalyarchives.uo007.protocol": "B",
      "codex.mcanomalyarchives.uo008.name": "百变命名牌",
      "codex.mcanomalyarchives.uo008.info": "深褐色的异常命名牌，出自一处矿井里的矿车宝藏。它倒置了命名的因果——不是按特性起名，而是按名字赋予特性。",
      "codex.mcanomalyarchives.uo008.trait": "只改内核、不改外壳 · 物品与方块必须过铁砧才能命名 · 物品耐久等于名字字数 · 命名不可逆，普通命名牌覆盖无效 · 跨类转化遵循质料守恒，撑不住就以爆炸偿付 · 现存数量被协会[数据删除]",
      "codex.mcanomalyarchives.uo008.level": "R1",
      "codex.mcanomalyarchives.uo008.protocol": "A",
      "codex.mcanomalyarchives.uo009.name": "假太阳",
      "codex.mcanomalyarchives.uo009.info": "高维投影天体，只有精神疾病患者能看见；它靠注视锚定现实，并放大观测者内心的渴望。",
      "codex.mcanomalyarchives.uo009.trait": "仅精神病患者可见 · 靠注视锚定于现实，专注越深成像越清晰 · 先放大内心渴望，再使人陷入宁静 · 形态随观测者的疾病而变 · 可改写集体认知",
      "codex.mcanomalyarchives.uo009.level": "R4",
      "codex.mcanomalyarchives.uo009.protocol": "A",
      "codex.mcanomalyarchives.uo010.name": "跨维窥镜",
      "codex.mcanomalyarchives.uo010.info": "一台灰色望远镜，五个旋钮可以窥视其他维度的事物；部分成像带有模因污染。",
      "codex.mcanomalyarchives.uo010.trait": "外观是灰色望远镜，材质酷似 UO-004 · 侧下有 α~ε 五个旋钮，δ、ε 已损坏 · α 调偏离现实程度、β 调时间、γ 调成像密度 · 部分成像带危险模因污染，会引发极端恐惧 · 同一人观测两次以上会致盲",
      "codex.mcanomalyarchives.uo010.level": "R1",
      "codex.mcanomalyarchives.uo010.protocol": "B",
      "codex.mcanomalyarchives.uo011.name": "怪树",
      "codex.mcanomalyarchives.uo011.info": "黑色的怪树，会钻地潜伏，并斩杀附近连续砍树的人；基岩可以困住它。",
      "codex.mcanomalyarchives.uo011.trait": "树干硬度接近基岩，无法破坏 · 树叶接近黑曜石，破坏后瞬间再生 · 累计砍 7~9 棵树即连根拔起钻入地下 · 以约 3.1 m/s 从地下接近，用镰刀状枝条斩杀 · 每砍一棵补种一棵树苗则不会触发",
      "codex.mcanomalyarchives.uo011.level": "R2",
      "codex.mcanomalyarchives.uo011.protocol": "C",
      "codex.mcanomalyarchives.uo012.name": "幸运粉羊",
      "codex.mcanomalyarchives.uo012.info": "平原上静静站着的粉色羊。注视它会得到好运；盯得太久，它会在你眨眼的一瞬间消失。",
      "codex.mcanomalyarchives.uo012.trait": "只在平原等温和开阔群系出现 · 目击满 2 秒获得幸运 · 凝视满 45 秒它会眨眼消失并转移 · 靠得太近或攻击它会招来三档灾厄 · 最高档灾厄没有任何预警",
      "codex.mcanomalyarchives.uo012.level": "R4",
      "codex.mcanomalyarchives.uo012.protocol": "B",
      "entity.mcanomalyarchives.sitting_enity": "",
      "item_group.mcanomalyarchives.strange_record": "MC诡异见闻录",
      "death.attack.meteor_strike": "%1$s被陨石砸成了坑",
      "entity.mcanomalyarchives.pink_sheep_gift": "粉羊的礼物",
      "item.mcanomalyarchives.baibian_name_tag": "百变命名牌",
      "nametag.mcanomalyarchives.need_name": "这张命名牌上什么都没写",
      "nametag.mcanomalyarchives.unknown": "档案里没有「%s」这个名字",
      "nametag.mcanomalyarchives.applied": "已命名：%s",
      "nametag.mcanomalyarchives.locked": "这个名字已经写死了——改不回来",
      "nametag.mcanomalyarchives.erased": "……什么都没留下",
      "nametag.mcanomalyarchives.planned": "该档案尚未被协会解明",
      "nametag.mcanomalyarchives.unstable": "它撑不住这个名字——别放到地上",
      "nametag.mcanomalyarchives.exploded": "差额用爆炸还了回来",
      "nametag.mcanomalyarchives.not_for_player": "命名牌对玩家不起作用",
      "nametag.mcanomalyarchives.no_output": "被改写的存在已经产不出原来的东西了",
      "nametag.mcanomalyarchives.draining": "它正从四周抽取%s",
      "nametag.mcanomalyarchives.dry": "附近找不到它能抽取的东西",
      "nametag.mcanomalyarchives.egg": "%s蛋"
    }
