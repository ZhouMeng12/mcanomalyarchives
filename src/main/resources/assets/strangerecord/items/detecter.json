{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "strangerecord:item/detecter_gui"
        }
      },
      {
        "when": "head",
        "model": {
          "type": "minecraft:model",
          "model": "strangerecord:item/detecter_head"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "strangerecord:item/detecter_world"
    }
  }
}
